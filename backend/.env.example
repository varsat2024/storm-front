AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_SESSION_TOKEN=your_session_token_here   # only needed for SSO / temporary credentials
AWS_REGION=us-east-2

# Geocoding (Assistant address → lat/lon). Mapbox is used when set; else US Census.
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
